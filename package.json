{
  "name": "devideo",
  "version": "0.2.10",
  "private": true,
  "description": "Desktop app to auto-generate video commercials using Google Flow and AI",
  "type": "module",
  "scripts": {
    "dev": "tauri dev",
    "build": "TAURI_SIGNING_PRIVATE_KEY=\"${TAURI_SIGNING_PRIVATE_KEY:-$(cat ~/.tauri/devideo.key 2>/dev/null || true)}\" TAURI_SIGNING_PRIVATE_KEY_PASSWORD=\"${TAURI_SIGNING_PRIVATE_KEY_PASSWORD:-}\" tauri build",
    "engine:build": "cd engine && bun run build",
    "engine:dev": "cd engine && bun run src/server-entry.ts",
    "bump": "bun ./scripts/bump-version.mjs"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.3.0"
  }
}
