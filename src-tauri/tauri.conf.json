{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "devideo",
  "version": "0.3.3",
  "identifier": "com.develapar.devideo",
  "build": {
    "beforeDevCommand": "cd ui && bun run build && cd ../engine && bun run build",
    "beforeBuildCommand": "cd ui && bun run build && cd ../engine && bun run build",
    "frontendDist": "../ui/dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "devideo",
        "width": 1440,
        "height": 900,
        "resizable": true,
        "fullscreen": false,
        "dragDropEnabled": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "binaries/engine.mjs"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEVEMjc0OTZBOTA5NkU1RUMKUldUczVaYVFha2tuN1didExHV3huNUc1aklqRG5XZTZoVUM5OC9CZzBwOUFOWENUM1gwenlGQ2gK",
      "endpoints": [
        "https://devideo-api.develapar.com/api/auth/update/latest.json"
      ]
    }
  }
}
